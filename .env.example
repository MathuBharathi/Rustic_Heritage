# Rustic Heritage Kitchenware — Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP / Email (server-side only — never expose in browser JS)
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

# Razorpay (server-side only — never expose in browser JS)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
